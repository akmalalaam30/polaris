# POLARIS backend configuration
# ---------------------------------------------------------------------------
# Copy to `.env` (in this directory or the project root) and edit.
# NEVER commit a filled-in .env - it is listed in .gitignore.
# Every value below has a working default; nothing here is required to start.
# ---------------------------------------------------------------------------

# === Data mode ==============================================================
# demo -> locally generated, clearly labelled synthetic fields. No network, no
#         credentials. Runs the identical pipeline.
# real -> ingest genuine observations from the providers listed below.
DATA_MODE=demo

# === Database ===============================================================
# SQLite is the default and needs no setup. PostgreSQL is the production target;
# PostGIS is detected automatically and used to add spatial indexes when present.
#
# {mode} is replaced by DATA_MODE. Keeping it means demo and real hold separate
# databases, so you can switch between them without rebuilding either - and a
# demo-trained model can never be fed real observations by accident. The same
# placeholder works in PROCESSED_DATA_DIR and MODEL_PATH. Remove it to force a
# single shared database.
# DATABASE_URL=postgresql+psycopg2://polaris:CHANGE_ME@localhost:5432/polaris
DATABASE_URL=sqlite:///./polaris_{mode}.db
DATABASE_ECHO=false

# === Logging ================================================================
LOG_LEVEL=INFO
# LOG_FILE=../logs/polaris.log

# === API ====================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
# Comma-separated origins, or * for any.
CORS_ORIGINS=*

# === Analysis domain ========================================================
# Default spans Maitri (11.7 E) to Bharati (76.2 E) with margin.
# A finer grid gives better routes but costs memory and time quadratically.
DOMAIN_LAT_MIN=-75.0
DOMAIN_LAT_MAX=-50.0
DOMAIN_LON_MIN=0.0
DOMAIN_LON_MAX=100.0
GRID_RESOLUTION_LAT=0.5
GRID_RESOLUTION_LON=1.0

# === Data providers =========================================================
# NSIDC Sea Ice Index v4 (G02135) - public, no credentials required.
NSIDC_BASE_URL=https://noaadata.apps.nsidc.org/NOAA/G02135
# US National Ice Center Antarctic iceberg bulletin - public, no credentials.
USNIC_ICEBERG_URL=https://usicecenter.gov/File/DownloadCurrent?pId=134

# ERA5 via the Copernicus Climate Data Store. Free account required:
#   https://cds.climate.copernicus.eu/  (then `pip install cdsapi`)
# ERA5_API_KEY=
ERA5_API_URL=https://cds.climate.copernicus.eu/api

# Copernicus Marine (CMEMS). Free account required:
#   https://data.marine.copernicus.eu/  (then `pip install copernicusmarine`)
# COPERNICUS_USERNAME=
# COPERNICUS_PASSWORD=
# Copernicus Marine splits the global physics product across several datasets;
# these ids are verified against the live catalogue. Requesting currents from
# the merged dataset fails - each variable group has its own dataset.
COPERNICUS_DATASET_CURRENTS=cmems_mod_glo_phy-cur_anfc_0.083deg_P1D-m
COPERNICUS_DATASET_TEMPERATURE=cmems_mod_glo_phy-thetao_anfc_0.083deg_P1D-m
COPERNICUS_DATASET_SALINITY=cmems_mod_glo_phy-so_anfc_0.083deg_P1D-m
# Sea-ice concentration, thickness and drift velocity (usi/vsi).
COPERNICUS_DATASET_SEAICE=cmems_mod_glo_phy_anfc_0.083deg_P1D-m
# Significant wave height (VHM0).
COPERNICUS_DATASET_WAVES=cmems_mod_glo_wav_anfc_0.083deg_PT3H-i

# When the credentialed providers above are not configured, real mode may fall
# back to the open, key-free mirrors that redistribute the same ERA5 / CMEMS
# products. Provenance is recorded separately, so a mirror-sourced record is
# never presented as having come from the primary service. Set to false to
# require the official APIs and have the ingestion be skipped without them.
ALLOW_OPEN_MIRRORS=true
OPEN_METEO_ERA5_URL=https://archive-api.open-meteo.com/v1/era5
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
MIRROR_SAMPLE_DLAT=2.0
MIRROR_SAMPLE_DLON=5.0

HTTP_TIMEOUT_SECONDS=60
DOWNLOAD_MAX_RETRIES=3

# === Filesystem =============================================================
# Defaults resolve relative to the project root; override for a shared volume.
# DATA_DIR=../data
# RAW_DATA_DIR=../data/raw
# PROCESSED_DATA_DIR=../data/processed/{mode}
# DEMO_DATA_DIR=../data/demo
# MODEL_PATH=../models/{mode}

# === Sea-ice forecasting ====================================================
SEA_ICE_MODEL_NAME=sea_ice_gbr
# Days of history built into data/processed/sea_ice_history.nc for training.
SEA_ICE_HISTORY_DAYS=400
SEA_ICE_MIN_TRAINING_DAYS=45
# Gridded observations kept in the relational database; the full history lives
# as NetCDF for training.
SEA_ICE_DB_RETENTION_DAYS=14

# === Iceberg trajectory =====================================================
ICEBERG_TIMESTEP_SECONDS=1800
# Monte-Carlo members used to estimate positional uncertainty. 0 disables it.
ICEBERG_ENSEMBLE_MEMBERS=24

# === Risk engine ============================================================
# Relative weights of the five risk components. They need not sum to 1; the
# total is normalised over the components that actually had data.
RISK_WEIGHT_SEA_ICE=0.40
RISK_WEIGHT_ICEBERG=0.25
RISK_WEIGHT_WEATHER=0.20
RISK_WEIGHT_OCEAN=0.10
RISK_WEIGHT_CONSTRAINT=0.05

# Concentration above which transit is blocked for a hull with no ice-breaking
# capability (the per-vessel limit is derived from its ice class).
SEA_ICE_IMPASSABLE_CONCENTRATION=0.90
ICEBERG_CRITICAL_DISTANCE_KM=15.0
ICEBERG_INFLUENCE_DISTANCE_KM=120.0

# === Route optimisation =====================================================
ROUTE_DISTANCE_WEIGHT=1.0
ROUTE_RISK_WEIGHT=1.0
ROUTE_FUEL_WEIGHT=1.0
# Cells above this total risk are removed from the navigation graph. If that
# disconnects the endpoints, POLARIS retries on a relaxed graph and marks the
# resulting route `degraded` rather than pretending it is compliant.
ROUTE_MAX_ACCEPTABLE_RISK=0.85
